# Copy to .env and fill in. Never commit .env.

# --- The agent service --------------------------------------------------------------------

# Required. The token the shop's backend (or helpdesk) sends as "Authorization: Bearer ...".
# Without it the service does not start.
AGENT_API_TOKEN=

# The model. Either an Anthropic API key...
ANTHROPIC_API_KEY=
# ...or a gateway token together with the gateway's address. A token without a base URL
# stops the start, so the token is never sent to the wrong host.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
# Optional. Default claude-opus-5-5.
ANTHROPIC_MODEL=

# Required. The agent's own database: conversations, messages, handoff tickets. If it does
# not answer, the service still starts, /ready is false, and turns answer 503.
DATABASE_URL=postgresql://agent_app:change-me-agent@postgres:5432/support_agent

# Required. The shop's orders service, and the agent's own token for it.
ORDERS_API_URL=http://orders-service:8001
ORDERS_API_TOKEN=

# Optional. Turns past this many at once answer 429 with Retry-After.
MAX_CONCURRENT_TURNS=4
# Optional. How many earlier messages each turn sees.
HISTORY_MAX_MESSAGES=20
# Optional. `python -m app.retention expire` removes conversations older than this.
RETENTION_DAYS=90
# Optional. DEBUG also logs message text and tool arguments, which are customer data.
LOG_LEVEL=INFO

# Optional tracing and metrics (OpenTelemetry over OTLP/HTTP). Off unless the endpoint is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=support-agent-claude

# --- The stand-in orders service and local PostgreSQL (compose only) --------------------

ORDERS_DATABASE_URL=postgresql://orders_app:change-me-orders@postgres:5432/orders
POSTGRES_PASSWORD=change-me-postgres
AGENT_DB_PASSWORD=change-me-agent
ORDERS_DB_PASSWORD=change-me-orders
